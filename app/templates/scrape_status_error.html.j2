<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scrape Error - {{ status.name }}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
      <li class="breadcrumb-item active" aria-current="page">{{ status.name }}</li>
    </ol>
  </nav>
  <h2>Scrape Error: {{ status.name }}</h2>
  <table class="table table-bordered table-sm" style="max-width: 700px;">
    <tbody>
    <tr>
      <th>Last Run</th>
      <td>{{ status.last_run_at | fmt_dt }}</td>
    </tr>
    <tr>
      <th>Result</th>
      <td class="{% if status.last_result == 'error' %}text-danger{% endif %}">{{ status.last_result }}</td>
    </tr>
    <tr>
      <th>Detail</th>
      <td>{{ status.detail }}</td>
    </tr>
    </tbody>
  </table>
  <h4>Error</h4>
  {% if status.error %}
  <pre class="bg-light border rounded p-3 text-danger" style="white-space: pre-wrap; word-break: break-word;">{{ status.error }}</pre>
  {% else %}
  <p class="text-muted">No error recorded.</p>
  {% endif %}
</div>
</body>
</html>
